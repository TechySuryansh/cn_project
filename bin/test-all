#!/usr/bin/env bash
# Layered integration test. Non-zero exit if any layer fails.
set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$REPO/scripts/common.sh"; load_config
banner "CN PHASE 1 - INTEGRATION TEST   (mode: $NETWORK_MODE)"
[ -n "${EDGE_IP:-}" ] && [ -n "${DNS_IP:-}" ] || die "Run your Mac's setup first (EDGE_IP/DNS_IP unknown)."
fails=0; total=0; names=()
echo "[1/9] Prerequisites";     "$REPO/scripts/verify-prerequisites.sh" || fails=$((fails+1)); total=$((total+1))
echo; echo "[2/9] Local network (Task A)"; "$REPO/scripts/macos-network-info.sh" | sed 's/^/  /'
i=3
for t in dns tcp tls backends http load_balancing cache; do
  echo; echo "[$i/9] ${t}"; i=$((i+1)); total=$((total+1))
  if ! "$REPO/tests/test_${t}.sh"; then fails=$((fails+1)); names+=("$t"); fi
done
echo
if [ $fails -eq 0 ]; then
  banner "ALL TESTS PASS - PHASE 1 SYSTEM HEALTHY"
  exit 0
fi
banner "$fails LAYER(S) FAILED: ${names[*]:-prerequisites}"
echo "Run ./bin/doctor for a layer-by-layer diagnosis."
exit 1
